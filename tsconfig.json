{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "types": ["node"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path mapping */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting — ★ 03.10 KALICI: strict açık (tsc --noEmit build zincirinde artık gerçek koruma;
       HafizlikTestiModal vakası gibi null/imza hatalarını canlı çökmeye gitmeden yakalar).
       noImplicitAny ayrıca kapalı: 142 TS7011 dönüş-tipi anotasyonu ayrı refactor — strict kalan
       bayraklar (strictNullChecks, strictFunctionTypes, useUnknownInCatchVariables…) aktif. */
    "strict": true,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "api", "server", "vite.config.ts"]
}
